{
  "name": "festivall-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build && node scripts/inject-og-tags.js",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "generate-qrs": "node ./scripts/generate-qrs.js",
    "reunion-analytics": "node ./scripts/reunion-analytics.js",
    "check-etransfer": "node ./scripts/check-etransfer.js",
    "start-live-bridge": "node ./scripts/live-bridge.js",
    "generate-fonts": "node ./scripts/generate-fonts.js"
  },
  "dependencies": {
    "@vueuse/head": "^2.0.0",
    "3d-force-graph": "^1.80.0",
    "axios": "^1.7.9",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "firebase": "^10.13.2",
    "firebase-admin": "^14.5.0",
    "html2canvas": "^1.4.1",
    "ical.js": "^2.1.0",
    "imapflow": "^1.3.3",
    "interactjs": "^1.10.27",
    "jspdf": "^3.0.0",
    "puppeteer": "^24.4.0",
    "qrcode": "^1.5.4",
    "three-spritetext": "^1.10.0",
    "uuid": "^11.0.5",
    "vue": "^3.4.15",
    "vue-qrcode-reader": "^5.5.3",
    "vue-router": "^4.2.5",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@iconify/vue": "^4.1.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "^20.11.10",
    "@types/papaparse": "^5.3.14",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.5.1",
    "@xmldom/xmldom": "^0.9.10",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "npm-run-all2": "^6.1.1",
    "prettier": "^3.0.3",
    "typescript": "~5.3.0",
    "vite": "^5.0.11",
    "vue-tsc": "^1.8.27"
  }
}
